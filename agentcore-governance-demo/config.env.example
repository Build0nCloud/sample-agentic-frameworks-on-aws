# ============================================================================
# Governance Demo — deployment configuration
#
# Copy this file to `config.env` and fill in the values, then run ./deploy-all.sh
#   cp config.env.example config.env
#
# config.env is git-ignored (it contains secrets). All other values are
# optional and have sensible defaults (see lib/common.sh).
# ============================================================================

# --- Region --------------------------------------------------------------
# The account id is auto-detected from your AWS credentials.
AWS_REGION=us-west-2

# --- Tavily web search (REQUIRED) ----------------------------------------
# The TavilyWebSearch target is a hosted MCP server. Get a key at
# https://app.tavily.com/  (the key is embedded in the target endpoint URL).
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- GitHub App (REQUIRED for the GitHubMCP target) ----------------------
# Create a GitHub App (Contents/Issues/PRs read-write, Metadata read), install
# it on a repo, and download its private key .pem. See README.md, "GitHub App".
GITHUB_APP_ID=123456
GITHUB_APP_INSTALLATION_ID=78901234
GITHUB_APP_PRIVATE_KEY_FILE=/absolute/path/to/your-app.private-key.pem

# --- Coding agents --------------------------------------------------------
# Which coding agent(s) to build and deploy into the persona runtimes.
# Space-separated slugs. Each enabled agent gets its own image and a runtime
# per persona (persona x agent). Governance is identical across agents.
#   claude-code : default; uses Bedrock via the runtime IAM role (no key needed)
#   devin       : Devin CLI; requires DEVIN_API_KEY below (stored in Secrets Manager)
# Example to run both: AGENTS="claude-code devin"
AGENTS="claude-code"

# --- Devin (REQUIRED only when 'devin' is in AGENTS) ----------------------
# Devin CLI reaches Cognition's backend for inference, so it needs an API key.
# The key is pushed to Secrets Manager at deploy time and fetched by the runtime;
# it is never baked into the image. Get a key from your Devin account settings.
# DEVIN_API_KEY=

# --- Optional overrides ---------------------------------------------------
# Uncomment to change defaults. Target names and persona names are referenced
# by the Cedar policies and the agent's baked-in settings, so leave them alone
# unless you know what you're changing.
# AGENT_MODEL=us.anthropic.claude-opus-4-6-v1
# GATEWAY_NAME=governance-mcp-gateway
# MEDICAL_TABLE_NAME=medical-records-demo
